# Server-side only. Do not commit a filled-in copy.
#
# Free Gemini key: https://aistudio.google.com/apikey
# Do not link a billing account to the project. A project with billing leaves the free tier.
SIMBENCH_PROVIDER=gemini
GEMINI_API_KEY=
SIMBENCH_MODEL=gemini-3.5-flash-lite

# Set to false only if the Gemini project has billing enabled. Used for the "free tier" label in logs.
# SIMBENCH_GEMINI_FREE_TIER=true

# Optional paid alternative:
# SIMBENCH_PROVIDER=openai
# OPENAI_API_KEY=
# SIMBENCH_MODEL=gpt-4o-mini
